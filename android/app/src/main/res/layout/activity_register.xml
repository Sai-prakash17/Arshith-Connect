<?xml version="1.0" encoding="utf-8"?>

<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#063F49">

    <!-- ===================================================== -->
    <!-- FULL SCREEN BUILDING BACKGROUND -->
    <!-- ===================================================== -->

    <ImageView
        android:id="@+id/imgBuilding"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/building_background"
        android:scaleType="centerCrop"
        android:alpha="0.88"
        android:contentDescription="@null" />

    <!-- Dark teal transparent overlay -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#45063F49" />

    <!-- ===================================================== -->
    <!-- MAIN SCROLL AREA -->
    <!-- ===================================================== -->

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="28dp"
            android:paddingBottom="25dp">

            <!-- ================================================= -->
            <!-- ARSHITH CONNECT LOGO -->
            <!-- ================================================= -->

            <ImageView
                android:id="@+id/imgArshithLogo"
                android:layout_width="250dp"
                android:layout_height="125dp"
                android:layout_marginTop="8dp"
                android:adjustViewBounds="true"
                android:scaleType="fitCenter"
                android:src="@drawable/arshith_connect_logo"
                android:contentDescription="Arshith Connect Logo" />

            <!-- ================================================= -->
            <!-- TAGLINE -->
            <!-- ================================================= -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="CONNECT  •  COLLABORATE  •  GROW"
                android:textColor="#E7F8F8"
                android:textSize="12sp"
                android:letterSpacing="0.16"
                android:fontFamily="sans"
                android:gravity="center" />

            <!-- ================================================= -->
            <!-- GRADIENT LINE -->
            <!-- ================================================= -->

            <View
                android:layout_width="145dp"
                android:layout_height="5dp"
                android:layout_marginTop="13dp"
                android:background="@drawable/brand_gradient_line" />

            <!-- ================================================= -->
            <!-- REGISTER HERE -->
            <!-- ================================================= -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Register Here"
                android:textColor="#FFFFFF"
                android:textSize="27sp"
                android:textStyle="normal"
                android:fontFamily="sans"
                android:gravity="center" />

            <!-- ================================================= -->
            <!-- REGISTRATION CARD -->
            <!-- ================================================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:padding="14dp"
                android:orientation="vertical"
                android:elevation="14dp"
                android:background="@drawable/register_card">

                <!-- ================================================= -->
                <!-- EMPLOYEE NAME -->
                <!-- ================================================= -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="70dp"
                    android:gravity="center_vertical"
                    android:background="@drawable/input_background">

                    <ImageView
                        android:layout_width="25dp"
                        android:layout_height="25dp"
                        android:layout_marginStart="14dp"
                        android:src="@drawable/ic_person"
                        android:tint="#527887"
                        android:contentDescription="@null" />

                    <EditText
                        android:id="@+id/etEmployeeName"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:background="@android:color/transparent"
                        android:hint="Employee Name"
                        android:textColor="#344E59"
                        android:textColorHint="#718088"
                        android:textSize="17sp"
                        android:inputType="textPersonName"
                        android:paddingStart="8dp"
                        android:paddingEnd="10dp"
                        android:singleLine="true" />

                </LinearLayout>

                <!-- ================================================= -->
                <!-- EMPLOYEE ID -->
                <!-- ================================================= -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="70dp"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:background="@drawable/input_background">

                    <ImageView
                        android:layout_width="25dp"
                        android:layout_height="25dp"
                        android:layout_marginStart="14dp"
                        android:src="@drawable/ic_badge"
                        android:tint="#527887"
                        android:contentDescription="@null" />

                    <EditText
                        android:id="@+id/etEmployeeId"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:background="@android:color/transparent"
                        android:hint="Employee ID No. (e.g. AFI-001)"
                        android:textColor="#344E59"
                        android:textColorHint="#718088"
                        android:textSize="17sp"
                        android:inputType="textCapCharacters"
                        android:paddingStart="8dp"
                        android:paddingEnd="10dp"
                        android:singleLine="true" />

                </LinearLayout>

                <!-- ================================================= -->
                <!-- EMAIL -->
                <!-- ================================================= -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="70dp"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:background="@drawable/input_background">

                    <ImageView
                        android:layout_width="25dp"
                        android:layout_height="25dp"
                        android:layout_marginStart="14dp"
                        android:src="@drawable/ic_email"
                        android:tint="#527887"
                        android:contentDescription="@null" />

                    <EditText
                        android:id="@+id/etEmail"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:background="@android:color/transparent"
                        android:hint="example@arshithgroup.com"
                        android:textColor="#344E59"
                        android:textColorHint="#718088"
                        android:textSize="17sp"
                        android:inputType="textEmailAddress"
                        android:paddingStart="8dp"
                        android:paddingEnd="10dp"
                        android:singleLine="true" />

                </LinearLayout>

                <!-- ================================================= -->
                <!-- PHONE -->
                <!-- ================================================= -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="70dp"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:background="@drawable/input_background">

                    <ImageView
                        android:layout_width="25dp"
                        android:layout_height="25dp"
                        android:layout_marginStart="14dp"
                        android:src="@drawable/ic_phone"
                        android:tint="#527887"
                        android:contentDescription="@null" />

                    <EditText
                        android:id="@+id/etPhone"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:background="@android:color/transparent"
                        android:hint="Phone Number"
                        android:textColor="#344E59"
                        android:textColorHint="#718088"
                        android:textSize="17sp"
                        android:inputType="phone"
                        android:maxLength="10"
                        android:paddingStart="8dp"
                        android:paddingEnd="10dp"
                        android:singleLine="true" />

                </LinearLayout>

                <!-- ================================================= -->
                <!-- PASSWORD -->
                <!-- ================================================= -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="70dp"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:background="@drawable/input_background">

                    <ImageView
                        android:layout_width="25dp"
                        android:layout_height="25dp"
                        android:layout_marginStart="14dp"
                        android:src="@drawable/ic_lock"
                        android:tint="#527887"
                        android:contentDescription="@null" />

                    <EditText
                        android:id="@+id/etPassword"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:background="@android:color/transparent"
                        android:hint="Password"
                        android:textColor="#344E59"
                        android:textColorHint="#718088"
                        android:textSize="17sp"
                        android:inputType="textPassword"
                        android:paddingStart="8dp"
                        android:paddingEnd="5dp"
                        android:singleLine="true" />

                    <ImageView
                        android:id="@+id/ivPasswordEye"
                        android:layout_width="27dp"
                        android:layout_height="27dp"
                        android:layout_marginEnd="14dp"
                        android:src="@drawable/ic_eye"
                        android:tint="#527887"
                        android:clickable="true"
                        android:focusable="true"
                        android:contentDescription="Show Password" />

                </LinearLayout>

                <!-- ================================================= -->
                <!-- CONFIRM PASSWORD -->
                <!-- ================================================= -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="70dp"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:background="@drawable/input_background">

                    <ImageView
                        android:layout_width="25dp"
                        android:layout_height="25dp"
                        android:layout_marginStart="14dp"
                        android:src="@drawable/ic_lock"
                        android:tint="#527887"
                        android:contentDescription="@null" />

                    <EditText
                        android:id="@+id/etConfirmPassword"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:background="@android:color/transparent"
                        android:hint="Confirm Password"
                        android:textColor="#344E59"
                        android:textColorHint="#718088"
                        android:textSize="17sp"
                        android:inputType="textPassword"
                        android:paddingStart="8dp"
                        android:paddingEnd="5dp"
                        android:singleLine="true" />

                    <ImageView
                        android:id="@+id/ivConfirmPasswordEye"
                        android:layout_width="27dp"
                        android:layout_height="27dp"
                        android:layout_marginEnd="14dp"
                        android:src="@drawable/ic_eye"
                        android:tint="#527887"
                        android:clickable="true"
                        android:focusable="true"
                        android:contentDescription="Show Password" />

                </LinearLayout>

                <!-- ================================================= -->
                <!-- REGISTER BUTTON -->
                <!-- ================================================= -->

                <Button
                    android:id="@+id/btnRegister"
                    android:layout_width="match_parent"
                    android:layout_height="62dp"
                    android:layout_marginTop="17dp"
                    android:background="@drawable/register_button"
                    android:elevation="5dp"
                    android:text="Register    →"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:fontFamily="sans" />

                <!-- ================================================= -->
                <!-- LOGIN -->
                <!-- ================================================= -->

                <TextView
                    android:id="@+id/tvLogin"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="18dp"
                    android:layout_marginBottom="5dp"
                    android:text="Already have an account?  Login"
                    android:textColor="#496875"
                    android:textSize="15sp"
                    android:fontFamily="sans"
                    android:clickable="true"
                    android:focusable="true" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</FrameLayout>