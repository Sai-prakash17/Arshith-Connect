<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="190dp"
    android:background="@drawable/admin_dashboard_background"
    android:gravity="bottom"
    android:orientation="vertical"
    android:padding="20dp">

    <ImageView
        android:id="@+id/imgAdminDrawerLogo"
        android:layout_width="150dp"
        android:layout_height="75dp"
        android:contentDescription="Arshith Connect"
        android:scaleType="fitCenter"
        android:src="@drawable/arshith_connect_logo" />

    <TextView
        android:id="@+id/tvDrawerAdminName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Administrator"
        android:textColor="#172A24"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvDrawerAdminRole"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Admin"
        android:textColor="#66756F"
        android:textSize="13sp" />

</LinearLayout>