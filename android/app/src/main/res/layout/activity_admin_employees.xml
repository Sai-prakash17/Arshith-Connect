<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F3FA">

    <!-- HEADER -->

    <LinearLayout
        android:id="@+id/headerLayout"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:background="#FFFFFF"
        android:elevation="4dp">

        <Button
            android:id="@+id/btnBack"
            android:layout_width="80dp"
            android:layout_height="40dp"
            android:text="BACK"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#555555"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:padding="0dp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="EMPLOYEES"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#251E32"
            android:singleLine="true" />

        <Button
            android:id="@+id/btnRefresh"
            android:layout_width="80dp"
            android:layout_height="40dp"
            android:text="REFRESH"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#7651E8"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:padding="0dp" />

    </LinearLayout>


    <!-- CONTENT -->

    <ScrollView
        android:id="@+id/employeeListContent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="20dp"
            android:paddingBottom="20dp">

            <!-- ATTENDANCE INFORMATION -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Attendance: Monday - Saturday"
                android:textColor="#666666"
                android:textSize="18sp"
                android:lineSpacingExtra="5dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Sunday and company holidays are excluded"
                android:textColor="#666666"
                android:textSize="18sp"
                android:lineSpacingExtra="5dp" />


            <!-- EMPLOYEES -->

            <LinearLayout
                android:id="@+id/employeesContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="25dp"
                android:orientation="vertical" />


            <!-- NO EMPLOYEES -->

            <TextView
                android:id="@+id/tvNoEmployees"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:gravity="center"
                android:text="No employees found."
                android:textColor="#777777"
                android:textSize="16sp"
                android:visibility="gone" />

        </LinearLayout>

    </ScrollView>


    <!-- PROGRESS -->

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone" />

</LinearLayout>