<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7FBF9"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- ====================================================== -->
        <!-- TOP BAR -->
        <!-- ====================================================== -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@android:color/transparent"
                android:contentDescription="Back"
                android:padding="10dp"
                android:src="@drawable/ic_arrow_back" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="My Profile"
                android:textColor="#172A24"
                android:textSize="24sp"
                android:textStyle="bold" />

            <Space
                android:layout_width="48dp"
                android:layout_height="48dp" />

        </LinearLayout>


        <!-- ====================================================== -->
        <!-- PROFILE PHOTO -->
        <!-- ====================================================== -->

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/imgProfile"
            android:layout_width="130dp"
            android:layout_height="130dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="28dp"
            android:contentDescription="Profile photo"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_profile_placeholder"
            app:shapeAppearanceOverlay="@style/ProfileImageCircle"
            app:strokeColor="#7B2EFF"
            app:strokeWidth="3dp" />


        <!-- ====================================================== -->
        <!-- CHANGE PHOTO -->
        <!-- ====================================================== -->

        <Button
            android:id="@+id/btnChoosePhoto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="14dp"
            android:text="ADD / CHANGE PHOTO"
            android:textStyle="bold" />


        <!-- ====================================================== -->
        <!-- NAME -->
        <!-- ====================================================== -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:text="Name"
            android:textColor="#172A24"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etProfileName"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="7dp"
            android:background="@drawable/profile_edittext_background"
            android:hint="Enter your name"
            android:inputType="textPersonName"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textColor="#172A24"
            android:textColorHint="#8A9691"
            android:textSize="16sp" />


        <!-- ====================================================== -->
        <!-- EMAIL -->
        <!-- ====================================================== -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Email"
            android:textColor="#172A24"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvProfileEmail"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="7dp"
            android:background="@drawable/profile_edittext_background"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textColor="#66756F"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Email is linked to your login account and is not changed here."
            android:textColor="#78857F"
            android:textSize="12sp" />


        <!-- ====================================================== -->
        <!-- SAVE -->
        <!-- ====================================================== -->

        <Button
            android:id="@+id/btnSaveProfile"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="30dp"
            android:layout_marginBottom="30dp"
            android:backgroundTint="#0B8F68"
            android:text="SAVE PROFILE"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

    </LinearLayout>

</ScrollView>