<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F5FC"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- ================================================= -->
        <!-- HEADER -->
        <!-- ================================================= -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:text="Team Management"
            android:textColor="#064E3B"
            android:textSize="28sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Create teams by selecting registered employees."
            android:textColor="#85818F"
            android:textSize="14sp"
            android:layout_marginBottom="22dp" />

        <!-- ================================================= -->
        <!-- CREATE TEAM CARD -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp"
            android:background="#FFFFFF"
            android:elevation="3dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Create New Team"
                android:textColor="#17132B"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginBottom="14dp" />

            <EditText
                android:id="@+id/etTeamName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Enter team name"
                android:textColor="#17132B"
                android:textColorHint="#85818F"
                android:textSize="16sp"
                android:padding="12dp"
                android:inputType="textCapWords"
                android:backgroundTint="#7651E8" />

            <!-- ================================================= -->
            <!-- EMPLOYEES -->
            <!-- ================================================= -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Select Employees"
                android:textColor="#17132B"
                android:textSize="17sp"
                android:textStyle="bold"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tvEmptyEmployees"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="No registered employees found."
                android:textColor="#85818F"
                android:textSize="14sp"
                android:visibility="gone"
                android:padding="10dp" />

            <LinearLayout
                android:id="@+id/employeesSelectionContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <!-- ================================================= -->
            <!-- CREATE TEAM BUTTON -->
            <!-- ================================================= -->

            <Button
                android:id="@+id/btnCreateTeam"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="CREATE TEAM"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="14sp"
                android:layout_marginTop="18dp"
                android:backgroundTint="#7651E8" />

        </LinearLayout>

        <!-- ================================================= -->
        <!-- EXISTING TEAMS -->
        <!-- ================================================= -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Existing Teams"
            android:textColor="#17132B"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="10dp" />

        <TextView
            android:id="@+id/tvEmptyTeams"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No teams created yet."
            android:textColor="#85818F"
            android:textSize="14sp"
            android:visibility="gone"
            android:padding="10dp" />

        <LinearLayout
            android:id="@+id/teamsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

    </LinearLayout>

</ScrollView>