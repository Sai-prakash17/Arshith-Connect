<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F5FC"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- HEADER -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Meeting Management"
            android:textColor="#251E32"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Schedule and manage employee meetings"
            android:textColor="#777080"
            android:textSize="14sp" />

        <!-- MEETING TITLE -->

        <EditText
            android:id="@+id/etMeetingTitle"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="25dp"
            android:background="#FFFFFF"
            android:hint="Meeting title"
            android:inputType="textCapSentences"
            android:padding="15dp"
            android:textColor="#251E32"
            android:textColorHint="#9993A0" />

        <!-- DATE -->

        <EditText
            android:id="@+id/etMeetingDate"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="12dp"
            android:background="#FFFFFF"
            android:clickable="true"
            android:focusable="false"
            android:hint="Select date"
            android:padding="15dp"
            android:textColor="#251E32"
            android:textColorHint="#9993A0" />

        <!-- TIME -->

        <EditText
            android:id="@+id/etMeetingTime"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="12dp"
            android:background="#FFFFFF"
            android:clickable="true"
            android:focusable="false"
            android:hint="Select time"
            android:padding="15dp"
            android:textColor="#251E32"
            android:textColorHint="#9993A0" />

        <!-- DESCRIPTION -->

        <EditText
            android:id="@+id/etMeetingDescription"
            android:layout_width="match_parent"
            android:layout_height="110dp"
            android:layout_marginTop="12dp"
            android:background="#FFFFFF"
            android:gravity="top"
            android:hint="Meeting description"
            android:inputType="textMultiLine|textCapSentences"
            android:padding="15dp"
            android:textColor="#251E32"
            android:textColorHint="#9993A0" />

        <!-- GOOGLE MEET LINK -->

        <EditText
            android:id="@+id/etMeetingLink"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="12dp"
            android:background="#FFFFFF"
            android:hint="Paste Google Meet link"
            android:inputType="textUri"
            android:padding="15dp"
            android:textColor="#251E32"
            android:textColorHint="#9993A0" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Paste the Google Meet link here. Selected employees will be able to join."
            android:textColor="#777080"
            android:textSize="12sp" />

        <!-- SEND TO -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Send Meeting To"
            android:textColor="#251E32"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spinnerMeetingAudience"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="8dp"
            android:background="#FFFFFF"
            android:paddingStart="12dp"
            android:paddingEnd="12dp" />

        <!-- SELECTED MEMBERS -->

        <TextView
            android:id="@+id/tvSelectedMembersTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Select Members"
            android:textColor="#251E32"
            android:textSize="16sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/selectedMembersContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#FFFFFF"
            android:orientation="vertical"
            android:padding="8dp"
            android:visibility="gone" />

        <!-- SCHEDULE -->

        <Button
            android:id="@+id/btnScheduleMeeting"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="20dp"
            android:backgroundTint="#7651E8"
            android:text="SCHEDULE MEETING"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

        <!-- SCHEDULED MEETINGS -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:text="Scheduled Meetings"
            android:textColor="#251E32"
            android:textSize="23sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/meetingsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="30dp" />

    </LinearLayout>

</ScrollView>