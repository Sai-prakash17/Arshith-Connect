<?xml version="1.0" encoding="utf-8"?>

<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F6F4FB">

    <!-- MAIN LEAVE MANAGEMENT SCREEN -->

    <ScrollView
        android:id="@+id/mainScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F6F4FB"
        android:fillViewport="true"
        android:visibility="visible">

        <LinearLayout
            android:id="@+id/requestsScreen"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- HEADER -->

            <TextView
                android:id="@+id/btnBack"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="‹  Back"
                android:textColor="#7651E8"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Leave Management"
                android:textColor="#241E31"
                android:textSize="30sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Apply for leave and manage your requests."
                android:textColor="#817A8B"
                android:textSize="15sp" />

            <!-- APPLY LEAVE BUTTON -->

            <Button
                android:id="@+id/btnShowApplyLeave"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="30dp"
                android:backgroundTint="#7950EF"
                android:elevation="3dp"
                android:text="APPLY FOR LEAVE"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- MY LEAVE REQUESTS -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:layout_marginBottom="16dp"
                android:text="My Leave Requests"
                android:textColor="#171329"
                android:textSize="25sp"
                android:textStyle="bold" />

            <!-- REQUEST CARDS -->

            <LinearLayout
                android:id="@+id/requestsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/tvNoRequests"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:padding="22dp"
                android:text="No leave requests yet"
                android:textColor="#918A9B"
                android:textSize="15sp"
                android:visibility="visible" />

        </LinearLayout>

    </ScrollView>


    <!-- APPLY LEAVE FORM SCREEN -->

    <ScrollView
        android:id="@+id/applyLeaveScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F6F4FB"
        android:fillViewport="true"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/applyLeaveForm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- BACK TO REQUESTS -->

            <TextView
                android:id="@+id/btnFormBack"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="‹  Back to Leave Requests"
                android:textColor="#7651E8"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Apply for Leave"
                android:textColor="#241E31"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Fill in the details for your leave request."
                android:textColor="#817A8B"
                android:textSize="14sp" />

            <!-- FORM CARD -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:background="#FFFFFF"
                android:elevation="2dp"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- FORM TITLE -->

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="New Leave Request"
                    android:textColor="#241E31"
                    android:textSize="21sp"
                    android:textStyle="bold" />

                <!-- LEAVE TYPE -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="Leave Type"
                    android:textColor="#40394B"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <Spinner
                    android:id="@+id/spinnerLeaveType"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="6dp"
                    android:backgroundTint="#7651E8" />

                <!-- LEAVE DURATION -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Leave Duration"
                    android:textColor="#40394B"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <Spinner
                    android:id="@+id/spinnerLeaveDuration"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="6dp"
                    android:backgroundTint="#7651E8" />

                <!-- FROM DATE -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="From Date"
                    android:textColor="#40394B"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnFromDate"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="6dp"
                    android:backgroundTint="#F0ECFF"
                    android:text="SELECT START DATE"
                    android:textColor="#7651E8"
                    android:textStyle="bold" />

                <!-- TO DATE -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:id="@+id/labelToDate"
                    android:text="To Date"
                    android:textColor="#40394B"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnToDate"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="6dp"
                    android:backgroundTint="#F0ECFF"
                    android:text="SELECT END DATE"
                    android:textColor="#7651E8"
                    android:textStyle="bold" />

                <!-- HOURLY LEAVE START TIME -->

                <TextView
                    android:id="@+id/labelStartTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Start Time"
                    android:textColor="#40394B"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/btnStartTime"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="6dp"
                    android:backgroundTint="#F0ECFF"
                    android:text="SELECT START TIME"
                    android:textColor="#7651E8"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/labelEndTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="End Time"
                    android:textColor="#40394B"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/btnEndTime"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="6dp"
                    android:backgroundTint="#F0ECFF"
                    android:text="SELECT END TIME"
                    android:textColor="#7651E8"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <!-- REASON -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Reason"
                    android:textColor="#40394B"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etLeaveReason"
                    android:layout_width="match_parent"
                    android:layout_height="105dp"
                    android:layout_marginTop="6dp"
                    android:background="#F3F1F8"
                    android:gravity="top|start"
                    android:hint="Enter reason for leave"
                    android:inputType="textMultiLine|textCapSentences"
                    android:padding="12dp"
                    android:textColor="#241E31"
                    android:textColorHint="#918A9B"
                    android:textSize="14sp" />

                <!-- SUBMIT -->

                <Button
                    android:id="@+id/btnSubmitLeave"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="20dp"
                    android:backgroundTint="#7950EF"
                    android:text="SUBMIT LEAVE REQUEST"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</FrameLayout>
