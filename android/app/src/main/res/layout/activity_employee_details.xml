<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/employeeDetailsRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7FBF9"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingEnd="22dp"
        android:paddingBottom="30dp">

        <!-- ================================================= -->
        <!-- TOP BAR -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@android:color/transparent"
                android:contentDescription="Back"
                android:padding="10dp"
                android:src="@drawable/ic_arrow_back" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Employee Profile"
                android:textColor="#172A24"
                android:textSize="22sp"
                android:textStyle="bold" />

            <View
                android:layout_width="48dp"
                android:layout_height="48dp" />

        </LinearLayout>


        <!-- ================================================= -->
        <!-- PROFILE CARD -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="#FFFFFF"
            android:elevation="4dp"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- ============================================= -->
            <!-- PROFILE PHOTO -->
            <!-- ============================================= -->

            <ImageView
                android:id="@+id/imgProfile"
                android:layout_width="135dp"
                android:layout_height="135dp"
                android:background="@drawable/profile_circle_background"
                android:contentDescription="Employee profile photo"
                android:padding="3dp"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_profile_placeholder" />

            <!-- ============================================= -->
            <!-- NAME -->
            <!-- ============================================= -->

            <TextView
                android:id="@+id/tvName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center"
                android:text="Employee"
                android:textColor="#172A24"
                android:textSize="24sp"
                android:textStyle="bold" />

            <!-- ============================================= -->
            <!-- EMAIL -->
            <!-- ============================================= -->

            <TextView
                android:id="@+id/tvEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="employee@gmail.com"
                android:textColor="#68756F"
                android:textSize="15sp" />

            <!-- ============================================= -->
            <!-- EMPLOYEE ID -->
            <!-- ============================================= -->

            <TextView
                android:id="@+id/tvEmployeeId"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="Employee ID"
                android:textColor="#8A9691"
                android:textSize="13sp" />

        </LinearLayout>


        <!-- ================================================= -->
        <!-- ATTENDANCE CARD -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="#FFFFFF"
            android:elevation="3dp"
            android:orientation="vertical"
            android:padding="22dp">

            <!-- ============================================= -->
            <!-- ATTENDANCE TITLE -->
            <!-- ============================================= -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Attendance"
                android:textColor="#172A24"
                android:textSize="17sp"
                android:textStyle="bold" />

            <!-- ============================================= -->
            <!-- ATTENDANCE VALUE -->
            <!-- ============================================= -->

            <TextView
                android:id="@+id/tvAttendance"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="0.0%"
                android:textColor="#7651E8"
                android:textSize="32sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Overall attendance"
                android:textColor="#8A9691"
                android:textSize="13sp" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>