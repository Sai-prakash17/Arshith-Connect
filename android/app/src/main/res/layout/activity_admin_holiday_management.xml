<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F5FC">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <Button
                android:id="@+id/btnBack"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:text="‹"
                android:textSize="30sp"
                android:textColor="#251E32"
                android:backgroundTint="#FFFFFF" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Holiday Management"
                    android:textColor="#251E32"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:layout_marginTop="4dp" />

            </LinearLayout>

        </LinearLayout>

        <!-- Add Holiday -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Add Holiday"
            android:textColor="#251E32"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="14dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="18dp"
            android:elevation="3dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Holiday Name"
                android:textColor="#5F5869"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etHolidayName"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:hint="Example: Independence Day"
                android:inputType="textCapSentences"
                android:padding="12dp"
                android:layout_marginTop="6dp" />

            <TextView
                android:id="@+id/tvHolidayDate"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Select holiday date"
                android:textColor="#5F5869"
                android:textSize="16sp"
                android:gravity="center_vertical"
                android:padding="12dp"
                android:background="#F2EFFA"
                android:layout_marginTop="14dp"
                android:clickable="true"
                android:focusable="true" />

            <Button
                android:id="@+id/btnAddHoliday"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="ADD HOLIDAY"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:backgroundTint="#7651E8"
                android:layout_marginTop="14dp" />

        </LinearLayout>

        <!-- Current Month -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Holiday List"
            android:textColor="#251E32"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="14dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#FFFFFF"
            android:padding="18dp"
            android:elevation="2dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Total Holidays"
                    android:textColor="#6D6677"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvHolidayCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="#7651E8"
                    android:textSize="32sp"
                    android:textStyle="bold"
                    android:layout_marginTop="4dp" />

            </LinearLayout>

            <Button
                android:id="@+id/btnRefresh"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="REFRESH"
                android:textStyle="bold"
                android:textColor="#7651E8"
                android:backgroundTint="#EEE8FF" />

        </LinearLayout>

        <!-- Holiday Records -->

        <TextView
            android:id="@+id/tvNoHolidays"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No holidays found."
            android:textColor="#777080"
            android:textSize="16sp"
            android:gravity="center"
            android:padding="30dp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/holidaysContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="30dp" />

    </LinearLayout>

</ScrollView>