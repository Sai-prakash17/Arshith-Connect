<?xml version="1.0" encoding="utf-8"?>

<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/employee_dashboard_background">

    <!-- ========================================================= -->
    <!-- MAIN DASHBOARD -->
    <!-- ========================================================= -->

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="25dp">

            <!-- ================================================= -->
            <!-- HEADER -->
            <!-- ================================================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="240dp"
                android:background="#EAF7F0"
                android:orientation="vertical"
                android:paddingStart="18dp"
                android:paddingTop="8dp"
                android:paddingEnd="24dp"
                android:paddingBottom="20dp">

                <!-- ============================================= -->
                <!-- MENU + LOGO -->
                <!-- ============================================= -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="105dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <!-- MENU BUTTON -->

                    <ImageButton
                        android:id="@+id/btnMenu"
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:background="@android:color/transparent"
                        android:contentDescription="Open navigation menu"
                        android:padding="12dp"
                        android:src="@android:drawable/ic_menu_sort_by_size"
                        android:tint="#064E3B" />

                    <!-- SPACE -->

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <!-- ARSHITH CONNECT LOGO -->

                    <ImageView
                        android:id="@+id/imgArshithLogo"
                        android:layout_width="180dp"
                        android:layout_height="95dp"
                        android:layout_marginTop="15dp"
                        android:adjustViewBounds="true"
                        android:background="@android:color/transparent"
                        android:contentDescription="Arshith Connect Logo"
                        android:scaleType="fitCenter"
                        android:src="@drawable/arshith_connect_logo" />

                </LinearLayout>


                <!-- ============================================= -->
                <!-- WELCOME -->
                <!-- ============================================= -->

                <TextView
                    android:id="@+id/tvWelcome"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Welcome,"
                    android:textColor="#000000"
                    android:textSize="25sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvRole"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="Employee"
                    android:textColor="#000000"
                    android:textSize="14sp" />

            </LinearLayout>


            <!-- ================================================= -->
            <!-- MAIN CONTENT -->
            <!-- ================================================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="-55dp"
                android:layout_marginEnd="20dp"
                android:orientation="vertical">


                <!-- ================================================= -->
                <!-- TODAY ATTENDANCE CARD -->
                <!-- ================================================= -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="#FFFFFF"
                    android:elevation="8dp"
                    android:orientation="vertical"
                    android:padding="22dp">

                    <!-- DATE + STATUS -->

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvCurrentDate"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:letterSpacing="0.08"
                                android:text="WED, SEP 23"
                                android:textColor="#777180"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvCurrentTime"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="5dp"
                                android:text="11:25 AM"
                                android:textColor="#211B32"
                                android:textSize="29sp"
                                android:textStyle="bold" />

                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvTodayStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="#E7F8EF"
                            android:paddingStart="13dp"
                            android:paddingTop="8dp"
                            android:paddingEnd="13dp"
                            android:paddingBottom="8dp"
                            android:text="● Not Checked In"
                            android:textColor="#22965B"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                    </LinearLayout>


                    <!-- ATTENDANCE DETAILS -->

                    <TextView
                        android:id="@+id/tvAttendanceStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:text="Your attendance for today"
                        android:textColor="#777180"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tvCheckIn"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="Check-in: --"
                        android:textColor="#3B3448"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tvCheckOut"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Check-out: --"
                        android:textColor="#3B3448"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tvWorkingDuration"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Working Duration: --"
                        android:textColor="#3B3448"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tvWorkMode"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Work Mode: --"
                        android:textColor="#3B3448"
                        android:textSize="14sp" />


                    <!-- CHECK BUTTONS -->

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btnCheckIn"
                            android:layout_width="0dp"
                            android:layout_height="52dp"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            android:backgroundTint="#7651E8"
                            android:text="CHECK IN"
                            android:textColor="#FFFFFF"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <Button
                            android:id="@+id/btnCheckOut"
                            android:layout_width="0dp"
                            android:layout_height="52dp"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            android:backgroundTint="#EDEAF5"
                            android:text="CHECK OUT"
                            android:textColor="#3B3448"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                </LinearLayout>


                <!-- ================================================= -->
                <!-- QUICK ACTIONS -->
                <!-- ================================================= -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="30dp"
                    android:text="Quick Actions"
                    android:textColor="#241E31"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Everything you need, in one place"
                    android:textColor="#918A9B"
                    android:textSize="13sp" />


                <!-- QUICK ACTION ROW 1 -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="112dp"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal"
                    android:weightSum="2">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAnnouncements"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginEnd="5dp"
                        android:layout_weight="1"
                        android:backgroundTint="#FFFFFF"
                        android:elevation="3dp"
                        android:gravity="center_vertical"
                        android:minHeight="0dp"
                        android:minWidth="0dp"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:text="Announcements"
                        android:textAllCaps="false"
                        android:textAlignment="viewStart"
                        android:textColor="#251E32"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        app:cornerRadius="18dp"
                        app:icon="@drawable/ic_notifications"
                        app:iconGravity="textStart"
                        app:iconPadding="8dp"
                        app:iconTint="#7651E8"
                        app:strokeColor="#E9E4F3"
                        app:strokeWidth="1dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnMeetings"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="5dp"
                        android:layout_weight="1"
                        android:backgroundTint="#FFFFFF"
                        android:elevation="3dp"
                        android:gravity="center_vertical"
                        android:minHeight="0dp"
                        android:minWidth="0dp"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:text="Meetings"
                        android:textAllCaps="false"
                        android:textAlignment="viewStart"
                        android:textColor="#251E32"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        app:cornerRadius="18dp"
                        app:icon="@drawable/ic_calendar"
                        app:iconGravity="textStart"
                        app:iconPadding="8dp"
                        app:iconTint="#4F46E5"
                        app:strokeColor="#E9E4F3"
                        app:strokeWidth="1dp" />

                </LinearLayout>


                <!-- QUICK ACTION ROW 2 -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="112dp"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal"
                    android:weightSum="2">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnWorkAssignments"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginEnd="5dp"
                        android:layout_weight="1"
                        android:backgroundTint="#FFFFFF"
                        android:elevation="3dp"
                        android:gravity="center_vertical"
                        android:minHeight="0dp"
                        android:minWidth="0dp"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:text="Work Assignments"
                        android:textAllCaps="false"
                        android:textAlignment="viewStart"
                        android:textColor="#251E32"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        app:cornerRadius="18dp"
                        app:icon="@drawable/ic_work"
                        app:iconGravity="textStart"
                        app:iconPadding="8dp"
                        app:iconTint="#14B8A6"
                        app:strokeColor="#E9E4F3"
                        app:strokeWidth="1dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnLeave"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="5dp"
                        android:layout_weight="1"
                        android:backgroundTint="#FFFFFF"
                        android:elevation="3dp"
                        android:gravity="center_vertical"
                        android:minHeight="0dp"
                        android:minWidth="0dp"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:text="Leave Management"
                        android:textAllCaps="false"
                        android:textAlignment="viewStart"
                        android:textColor="#251E32"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        app:cornerRadius="18dp"
                        app:icon="@drawable/ic_leave"
                        app:iconGravity="textStart"
                        app:iconPadding="8dp"
                        app:iconTint="#F59E0B"
                        app:strokeColor="#E9E4F3"
                        app:strokeWidth="1dp" />

                </LinearLayout>


                <!-- LOGOUT -->

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnLogout"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="24dp"
                    android:layout_marginBottom="25dp"
                    android:backgroundTint="#FFF7F7"
                    android:elevation="1dp"
                    android:gravity="center"
                    android:minHeight="0dp"
                    android:minWidth="0dp"
                    android:text="Log Out"
                    android:textAllCaps="false"
                    android:textColor="#D04444"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:cornerRadius="16dp"
                    app:strokeColor="#F1DADA"
                    app:strokeWidth="1dp" />


                <!-- HIDDEN FUNCTIONAL VIEWS -->

                <Button
                    android:id="@+id/btnWFO"
                    android:layout_width="1dp"
                    android:layout_height="1dp"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/btnWFH"
                    android:layout_width="1dp"
                    android:layout_height="1dp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tvWorkingDays"
                    android:layout_width="1dp"
                    android:layout_height="1dp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tvPresentDays"
                    android:layout_width="1dp"
                    android:layout_height="1dp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tvAbsentDays"
                    android:layout_width="1dp"
                    android:layout_height="1dp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tvAttendancePercentage"
                    android:layout_width="1dp"
                    android:layout_height="1dp"
                    android:visibility="gone" />

                <ProgressBar
                    android:id="@+id/attendanceProgress"
                    android:layout_width="1dp"
                    android:layout_height="1dp"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/btnHistory"
                    android:layout_width="1dp"
                    android:layout_height="1dp"
                    android:visibility="gone" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>


    <!-- ========================================================= -->
    <!-- SIDE NAVIGATION DRAWER -->
    <!-- ========================================================= -->

    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navigationView"
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="#FFFFFF"
        android:fitsSystemWindows="true"
        app:headerLayout="@layout/drawer_header_employee"
        app:itemIconTint="#064E3B"
        app:itemTextColor="#251E32"
        app:menu="@menu/employee_drawer_menu" />

</androidx.drawerlayout.widget.DrawerLayout>