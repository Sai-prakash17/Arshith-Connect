<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F5FC"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- ================================================= -->
        <!-- HEADER -->
        <!-- ================================================= -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Announcements"
            android:textColor="#251E32"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="Create and manage announcements for employees."
            android:textColor="#777080"
            android:textSize="14sp" />

        <!-- ================================================= -->
        <!-- MAIN ANNOUNCEMENT PAGE -->
        <!-- ================================================= -->

        <LinearLayout
            android:id="@+id/announcementHomeLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ADD ANNOUNCEMENT BUTTON -->

            <Button
                android:id="@+id/btnAddAnnouncement"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginTop="28dp"
                android:backgroundTint="#7651E8"
                android:text="ADD ANNOUNCEMENT"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <!-- ================================================= -->
            <!-- PUBLISHED ANNOUNCEMENTS -->
            <!-- ================================================= -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="Published Announcements"
                android:textColor="#17132B"
                android:textSize="22sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/announcementsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="vertical" />

        </LinearLayout>


        <!-- ================================================= -->
        <!-- CREATE ANNOUNCEMENT PAGE -->
        <!-- HIDDEN WHEN ACTIVITY OPENS -->
        <!-- ================================================= -->

        <LinearLayout
            android:id="@+id/createAnnouncementLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- CREATE TITLE -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="Create Announcement"
                android:textColor="#17132B"
                android:textSize="22sp"
                android:textStyle="bold" />

            <!-- TITLE -->

            <EditText
                android:id="@+id/etAnnouncementTitle"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginTop="14dp"
                android:background="@android:drawable/editbox_background"
                android:hint="Announcement title"
                android:inputType="textCapSentences"
                android:padding="14dp"
                android:textColor="#251E32"
                android:textColorHint="#99939F"
                android:textSize="15sp" />

            <!-- MESSAGE -->

            <EditText
                android:id="@+id/etAnnouncementMessage"
                android:layout_width="match_parent"
                android:layout_height="130dp"
                android:layout_marginTop="12dp"
                android:background="@android:drawable/editbox_background"
                android:gravity="top|start"
                android:hint="Write announcement message..."
                android:inputType="textCapSentences|textMultiLine"
                android:padding="14dp"
                android:textColor="#251E32"
                android:textColorHint="#99939F"
                android:textSize="15sp" />

            <!-- TYPE LABEL -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Announcement Type"
                android:textColor="#5F5869"
                android:textSize="13sp"
                android:textStyle="bold" />

            <!-- TYPE -->

            <Spinner
                android:id="@+id/spinnerAnnouncementType"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="6dp"
                android:background="#FFFFFF" />

            <!-- ================================================= -->
            <!-- SEND TO -->
            <!-- ================================================= -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Send To"
                android:textColor="#5F5869"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/spinnerSendTo"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="6dp"
                android:background="#FFFFFF" />

            <!-- SELECT EMPLOYEES BUTTON -->

            <Button
                android:id="@+id/btnSelectEmployees"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="10dp"
                android:backgroundTint="#064E3B"
                android:text="SELECT MEMBERS"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:visibility="gone" />

            <!-- SELECTED MEMBERS -->

            <TextView
                android:id="@+id/tvSelectedMembers"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="No members selected"
                android:textColor="#064E3B"
                android:textSize="13sp"
                android:visibility="gone" />

            <!-- ================================================= -->
            <!-- PUBLISH BUTTON -->
            <!-- ================================================= -->

            <Button
                android:id="@+id/btnPublishAnnouncement"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginTop="16dp"
                android:backgroundTint="#7651E8"
                android:text="PUBLISH ANNOUNCEMENT"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />

            <!-- ================================================= -->
            <!-- CANCEL BUTTON -->
            <!-- ================================================= -->

            <Button
                android:id="@+id/btnCancelAnnouncement"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginTop="10dp"
                android:backgroundTint="#D04444"
                android:text="CANCEL"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />

        </LinearLayout>


        <!-- BOTTOM SPACE -->

        <View
            android:layout_width="match_parent"
            android:layout_height="30dp" />

    </LinearLayout>

</ScrollView>