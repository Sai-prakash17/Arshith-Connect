<?xml version="1.0" encoding="utf-8"?>

<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ========================================================= -->
    <!-- LOCATION PERMISSIONS -->
    <!-- ========================================================= -->

    <uses-permission
        android:name="android.permission.ACCESS_FINE_LOCATION" />

    <uses-permission
        android:name="android.permission.ACCESS_COARSE_LOCATION" />


    <!-- ========================================================= -->
    <!-- CAMERA PERMISSION -->
    <!-- ========================================================= -->

    <uses-permission
        android:name="android.permission.CAMERA" />

    <uses-permission
        android:name="android.permission.POST_NOTIFICATIONS" />


    <!-- ========================================================= -->
    <!-- CAMERA FEATURE -->
    <!-- Camera is optional because WFH does not require camera -->
    <!-- ========================================================= -->

    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <uses-feature
        android:name="android.hardware.camera.autofocus"
        android:required="false" />


    <!-- ========================================================= -->
    <!-- CAMERA APP VISIBILITY -->
    <!-- Required for checking ACTION_IMAGE_CAPTURE -->
    <!-- ========================================================= -->

    <queries>

        <intent>
            <action
                android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>

    </queries>


    <!-- ========================================================= -->
    <!-- APPLICATION -->
    <!-- ========================================================= -->

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ArshithConnect">


        <!-- ===================================================== -->
        <!-- FILE PROVIDER -->
        <!-- ===================================================== -->

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">

            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />

        </provider>
        <service
            android:name=".MyFirebaseMessagingService"
            android:exported="false">

            <intent-filter>

                <action
                    android:name="com.google.firebase.MESSAGING_EVENT" />

            </intent-filter>

        </service>


        <!-- ===================================================== -->
        <!-- ADMIN / EMPLOYEE ACTIVITIES -->
        <!-- ===================================================== -->

        <activity
            android:name=".AdminOfficeTimingsActivity"
            android:exported="false" />

        <activity
            android:name=".AdminRegistrationRequestsActivity"
            android:exported="false" />

        <activity
            android:name="com.yalantis.ucrop.UCropActivity"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.AppCompat.Light.NoActionBar" />
        <activity
            android:name=".AdminEmployeeProfileActivity"
            android:exported="false" />
        <activity
            android:name=".EmployeeProfileActivity"
            android:exported="false" />
        <activity
            android:name=".AdminWorkUpdateActivity"
            android:exported="false" />
        <activity
            android:name=".EmployeeWorkUpdateActivity"
            android:exported="false" />

        <activity
            android:name=".AdminEmployeeListActivity"
            android:exported="false" />

        <activity
            android:name=".EmployeeDetailsActivity"
            android:exported="false" />

        <activity
            android:name=".AdminEmployeeManagementActivity"
            android:exported="false" />

        <activity
            android:name=".AdminTeamManagementActivity"
            android:exported="false" />

        <activity
            android:name=".EmployeeWorkAssignmentsActivity"
            android:exported="false" />

        <activity
            android:name=".EmployeeManagementActivity"
            android:exported="false" />

        <activity
            android:name=".AdminWorkAssignmentActivity"
            android:exported="false" />

        <activity
            android:name=".EmployeeAnnouncementsActivity"
            android:exported="false" />

        <activity
            android:name=".AdminAnnouncementManagementActivity"
            android:exported="false" />

        <activity
            android:name=".EmployeeMeetingManagementActivity"
            android:exported="false" />

        <activity
            android:name=".MeetingRoomActivity"
            android:exported="false" />

        <activity
            android:name=".AdminMeetingManagementActivity"
            android:exported="false" />

        <activity
            android:name=".RegisterActivity"
            android:exported="false" />

        <activity
            android:name=".AdminAttendanceReportsActivity"
            android:exported="false" />

        <activity
            android:name=".AdminLeaveManagementActivity"
            android:exported="false" />

        <activity
            android:name=".AdminHolidayManagementActivity"
            android:exported="false" />

        <activity
            android:name=".AdminAttendanceManagementActivity"
            android:exported="false" />

        <activity
            android:name=".AdminLoginActivity"
            android:exported="false" />

        <activity
            android:name=".AdminDashboardActivity"
            android:exported="false" />

        <activity
            android:name=".LeaveManagementActivity"
            android:exported="false" />

        <activity
            android:name=".EmployeeDashboardActivity"
            android:exported="false" />


        <!-- ===================================================== -->
        <!-- MAIN ACTIVITY -->
        <!-- ===================================================== -->

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.ArshithConnect"
            android:windowSoftInputMode="adjustResize">

            <intent-filter>

                <action
                    android:name="android.intent.action.MAIN" />

                <category
                    android:name="android.intent.category.LAUNCHER" />

            </intent-filter>

        </activity>

    </application>

</manifest>