PROJECT_NAME="Arshith Connect API"
API_V1_STR="/api"
SECRET_KEY="your_secure_jwt_secret_key_here"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ==============================================================================
# FIREBASE DATABASE & STORAGE CONFIGURATION
# ==============================================================================
# Database Backend selector: "firebase" (recommended) or "postgres"
DATABASE_BACKEND=firebase

# >>> WRITE YOUR FIRESTORE DATABASE NAME HERE <<<
# If using the default Firestore database, keep "(default)"
# If you created a custom named database in Firebase Console, enter its ID here (e.g. "arshith_connect_db")
FIREBASE_DATABASE_NAME="(default)"

# Your Firebase Project ID (from Firebase Console > Project Settings)
FIREBASE_PROJECT_ID="arshith-connect-attendance"

# Your Firebase Cloud Storage Bucket name
FIREBASE_STORAGE_BUCKET="arshith-connect-attendance.firebasestorage.app"

# Service Account Key Credentials
# Option 1: Path to serviceAccountKey.json downloaded from Firebase Console > Project Settings > Service Accounts
FIREBASE_CREDENTIALS_PATH="serviceAccountKey.json"

# Option 2: Standard Google Application Credentials environment variable
# GOOGLE_APPLICATION_CREDENTIALS="serviceAccountKey.json"

# Option 3: Raw service account JSON string (useful for CI/CD or Cloud Deployments)
# FIREBASE_CREDENTIALS_JSON='{"type": "service_account", ...}'

# ==============================================================================
# POSTGRESQL CONFIGURATION (Preserved for migration and fallback)
# ==============================================================================
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_DB=arshith_connect_db
DATABASE_URL=postgresql+psycopg://postgres:your_postgres_password@localhost:5432/arshith_connect_db

FRONTEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
ATTENDANCE_TIMEZONE=Asia/Kolkata
